PORT=5001
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/cambo_rent

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Stripe (optional – leave empty for mock mode)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP (optional – logs to console if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Client URL (for password reset links)
CLIENT_URL=http://localhost:4200

# App URLs (used to build PayWay return/success URLs)
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5001

# ABA PayWay (SANDBOX) — ask a teammate for the current Merchant ID + Public Key.
# The "Public Key" is the HMAC api_key used to sign requests. Do NOT commit real
# values; keep them in your local .env only.
PAYWAY_MERCHANT_ID=your-merchant-id
PAYWAY_API_KEY=your-public-key
PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
PAYWAY_CHECK_TX_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2
PAYWAY_CURRENCY=USD
