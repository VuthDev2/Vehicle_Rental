# ============================================================
# Cambo Rent Backend — Environment Variables Template
# Copy this file to .env and fill in your own values.
# NEVER commit your real .env file to version control.
# ============================================================

# ─── Server ─────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ─── Auth ───────────────────────────────────────────────────
# Generate strong, unique secrets for production.
# Tip: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=7d

# ─── Google OAuth ────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Database ────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Redis (optional) ────────────────────────────────────────
# Leave empty or unset to disable Redis (rate limiting falls back to memory).
REDIS_URI=redis://localhost:6379

# ─── App URLs ────────────────────────────────────────────────
# Used for CORS and to build PayWay callback URLs.
# In production, set these to your deployed domain(s).
# FRONTEND_URL supports comma-separated values for multi-domain:
#   FRONTEND_URL=https://app.example.com,https://www.example.com
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5001

# ─── ABA PayWay ──────────────────────────────────────────────
# Get credentials from your PayWay merchant dashboard.
PAYWAY_MERCHANT_ID=your_merchant_id
PAYWAY_API_KEY=your_api_key
PAYWAY_API_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/purchase
PAYWAY_CHECK_TX_URL=https://checkout-sandbox.payway.com.kh/api/payment-gateway/v1/payments/check-transaction-2
PAYWAY_CURRENCY=USD

# ─── Email (Nodemailer + Gmail) ───────────────────────────────
# See: https://support.google.com/accounts/answer/185833
# Generate an App Password in your Google Account under Security → 2-Step Verification → App Passwords.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password
EMAIL_FROM='"Cambo Rent" <your_gmail@gmail.com>'
