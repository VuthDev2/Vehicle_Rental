# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# ─── Compiled output ────────────────────────────────────────────────────────
/dist
/tmp
/out-tsc
/bazel-out

# ─── Node ───────────────────────────────────────────────────────────────────
/node_modules
backend/node_modules
npm-debug.log
yarn-error.log
*.log

# ─── Environment / Secrets ──────────────────────────────────────────────────
# Never commit .env — only .env.example is safe to commit.
backend/.env
.env
*.txt
*.sh

# ─── Database dumps ─────────────────────────────────────────────────────────
*.rdb
dump.rdb
backend/dump.rdb

# ─── Dev scratch & temp ─────────────────────────────────────────────────────
/scratch
/tmp
backend/test-*.js
backend/query_*.js

# ─── Python virtual environments ────────────────────────────────────────────
venv/
venv_rembg/
__pycache__/
*.pyc

# ─── IDEs and editors ───────────────────────────────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# ─── Visual Studio Code ─────────────────────────────────────────────────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.history/*

# ─── Angular ────────────────────────────────────────────────────────────────
/.angular/cache
.sass-cache/
/coverage
/typings
__screenshots__/
/connect.lock
/libpeerconnection.log
testem.log

# ─── System files ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Deployment ─────────────────────────────────────────────────────────────
.netlify
